#
# The session that greetd starts. It holds the PSLDM greeter.
#
# Install it at /usr/bin/psldm-greeter-session, or wherever install.sh puts
# the programs. /etc/greetd/config.toml names this file.

Hyprland --config /etc/greetd/hyprland.conf
status=$?

# Erase the console before the user session starts.
#
# The compositor gives the virtual terminal back in text mode when it stops.
# The screen then shows the console until the user session draws its first
# frame. These codes hide the cursor and erase the screen and the scrollback,
# so the wait is black instead of text.
printf '\033[?25l\033[3J\033[2J\033[H' >/dev/tty 2>/dev/null || true

exit "$status"
